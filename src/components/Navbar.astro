---
---

<header class="sticky top-0 z-40 w-full backdrop-blur-md bg-[#080c14]/85 border-b border-slate-800/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      
      <!-- Logo & City Tag -->
      <a href="/" class="flex items-center gap-3 group">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-[#F7931A] to-[#C96F07] p-[1.5px] shadow-lg shadow-[#F7931A]/20">
          <div class="w-full h-full bg-[#0E1626] rounded-[10px] flex items-center justify-center font-mono font-bold text-[#F7931A] text-xl group-hover:scale-105 transition-transform">
            ₿
          </div>
        </div>
        <div class="flex flex-col">
          <span class="font-extrabold text-base sm:text-lg tracking-tight text-white flex items-center gap-2">
            BitDevs <span class="text-[#F7931A]">Kisumu</span>
          </span>
          <span class="text-[10px] font-mono text-slate-400 tracking-wider">
            0°05'S, 34°46'E • KENYA
          </span>
        </div>
      </a>

      <!-- Desktop Nav Links -->
      <nav class="hidden md:flex items-center gap-1 lg:gap-2 text-sm font-medium text-slate-300">
        <a href="#seminars" class="px-3 py-2 rounded-lg hover:text-white hover:bg-slate-800/50 transition-colors">
          Socratic Seminars
        </a>
        <a href="#devs" class="px-3 py-2 rounded-lg hover:text-white hover:bg-slate-800/50 transition-colors">
          Dev Showcase
        </a>
        <a href="#satellite" class="px-3 py-2 rounded-lg hover:text-white hover:bg-slate-800/50 transition-colors flex items-center gap-1.5">
          <span class="inline-block w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          Offline & Satellite
        </a>
        <a href="#earn" class="px-3 py-2 rounded-lg hover:text-white hover:bg-slate-800/50 transition-colors">
          Earn Sats
        </a>
      </nav>

      <!-- Action Buttons -->
      <div class="hidden sm:flex items-center gap-3">
        <button 
          id="open-treasury-btn"
          class="px-3.5 py-1.5 rounded-lg border border-[#F7931A]/30 bg-[#F7931A]/10 hover:bg-[#F7931A]/20 text-[#F7931A] text-xs font-semibold font-mono transition-all flex items-center gap-1.5 shadow-sm"
          data-dev-id="treasury"
          data-dev-name="BitDevs Kisumu Treasury"
          data-lightning="bitdevskisumu@getalby.com"
        >
          ⚡ Support Kisumu Guild
        </button>

        <a 
          href="https://github.com" 
          target="_blank" 
          rel="noopener noreferrer"
          class="p-2 rounded-lg border border-slate-800 hover:border-slate-700 bg-slate-900/60 hover:text-white text-slate-300 transition-colors"
          title="GitHub Repository"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
          </svg>
        </a>
      </div>

      <!-- Mobile menu button -->
      <button 
        id="mobile-menu-toggle"
        class="md:hidden p-2 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 focus:outline-none"
        aria-label="Toggle Navigation Menu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-slate-800 bg-[#0c121e] px-4 pt-3 pb-6 space-y-2">
    <a href="#seminars" class="block px-3 py-2 rounded-md text-base font-medium text-slate-200 hover:bg-slate-800">
      Socratic Seminars
    </a>
    <a href="#devs" class="block px-3 py-2 rounded-md text-base font-medium text-slate-200 hover:bg-slate-800">
      Kisumu Dev Showcase
    </a>
    <a href="#satellite" class="block px-3 py-2 rounded-md text-base font-medium text-slate-200 hover:bg-slate-800">
      Offline & Satellite Guide
    </a>
    <a href="#earn" class="block px-3 py-2 rounded-md text-base font-medium text-slate-200 hover:bg-slate-800">
      Earn Sats (Bounties)
    </a>
    <div class="pt-3 border-t border-slate-800 flex flex-col gap-2">
      <button 
        class="w-full py-2.5 rounded-lg border border-[#F7931A]/30 bg-[#F7931A]/10 text-[#F7931A] text-sm font-semibold font-mono flex items-center justify-center gap-2"
        data-dev-id="treasury"
        data-dev-name="BitDevs Kisumu Treasury"
        data-lightning="bitdevskisumu@getalby.com"
      >
        ⚡ Support Kisumu Guild in Sats
      </button>
      <a 
        href="https://t.me/+bitdevskisumu" 
        target="_blank" 
        rel="noopener noreferrer"
        class="w-full py-2.5 rounded-lg bg-blue-600/20 text-blue-400 text-sm font-semibold flex items-center justify-center gap-2 border border-blue-500/30"
      >
        💬 Join Kisumu BitDevs Telegram
      </a>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');

  if (toggleBtn && menu) {
    toggleBtn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });

    const menuLinks = menu.querySelectorAll('a');
    menuLinks.forEach(link => {
      link.addEventListener('click', () => {
        menu.classList.add('hidden');
      });
    });
  }
</script>
