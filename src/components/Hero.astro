---
---

<section class="relative pt-12 pb-16 md:pt-20 md:pb-24 overflow-hidden border-b border-slate-800/60">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mx-auto text-center">
      
      <!-- Top pill badge & Forge callout -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 mb-6">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-[#F7931A]/30 bg-[#F7931A]/10 text-xs font-mono font-semibold text-[#F7931A] shadow-sm">
          <span class="w-2 h-2 rounded-full bg-[#F7931A] animate-ping"></span>
          <span>BitDevs Kisumu • Western Kenya</span>
        </div>

        <a 
          href="/forge" 
          class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-amber-500/40 bg-gradient-to-r from-amber-500/15 via-[#F7931A]/25 to-emerald-500/15 text-xs font-mono font-bold text-slate-100 hover:border-[#F7931A] transition-all group shadow-md"
        >
          <span class="px-1.5 py-0.5 rounded bg-[#F7931A] text-black text-[9px] font-extrabold">NEW FORGE</span>
          <span>Train in Go & Earn 1.2M Sats on Live PRs</span>
          <span class="text-[#F7931A] group-hover:translate-x-1 transition-transform">→</span>
        </a>
      </div>

      <!-- Main Headline -->
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold text-white tracking-tight leading-[1.12]">
        Building the Bitcoin Frontier on <span class="bg-gradient-to-r from-[#F7931A] via-amber-400 to-[#38BDF8] bg-clip-text text-transparent">Lake Victoria</span>
      </h1>

      <!-- Subtitle -->
      <p class="mt-6 text-lg sm:text-xl text-slate-300 leading-relaxed font-normal">
        We are software engineers, protocol researchers, and builders in Kisumu, Kenya. We host deep technical Socratic seminars, test offline satellite node synchronization, and empower local talent to attract global payments and earn in Bitcoin.
      </p>

      <!-- Primary Action CTAs -->
      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a 
          href="#devs" 
          class="w-full sm:w-auto px-6 py-3.5 rounded-xl bg-gradient-to-r from-[#F7931A] to-[#E27909] text-black font-bold text-sm sm:text-base hover:brightness-110 active:scale-[0.98] transition-all shadow-lg shadow-[#F7931A]/20 flex items-center justify-center gap-2"
        >
          <span>⚡ Hire & Support Kisumu Devs</span>
          <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/>
          </svg>
        </a>

        <a 
          href="#seminars" 
          class="w-full sm:w-auto px-6 py-3.5 rounded-xl border border-slate-700 hover:border-slate-500 bg-slate-900/80 hover:bg-slate-800 text-white font-semibold text-sm sm:text-base transition-all flex items-center justify-center gap-2"
        >
          <span>📖 Next Socratic Seminar</span>
          <span class="text-xs px-2 py-0.5 rounded bg-slate-800 text-[#F7931A] font-mono font-medium">Nov 7</span>
        </a>
      </div>

      <!-- Quick Metrics & Feature Grid -->
      <div class="mt-14 pt-10 border-t border-slate-800/80 grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6 text-left">
        <div class="p-4 rounded-xl bg-slate-900/40 border border-slate-800/60 backdrop-blur-sm">
          <div class="text-2xl font-mono font-bold text-[#F7931A]">Socratic</div>
          <div class="text-xs text-slate-400 mt-1">Chatham House rule technical protocol discussions</div>
        </div>

        <div class="p-4 rounded-xl bg-slate-900/40 border border-slate-800/60 backdrop-blur-sm">
          <div class="text-2xl font-mono font-bold text-[#38BDF8]">0°05' S</div>
          <div class="text-xs text-slate-400 mt-1">Preset satellite dish angles for zero-internet sync</div>
        </div>

        <div class="p-4 rounded-xl bg-slate-900/40 border border-slate-800/60 backdrop-blur-sm">
          <div class="text-2xl font-mono font-bold text-emerald-400">Lightning</div>
          <div class="text-xs text-slate-400 mt-1">Direct LNURL tipping & remote cross-border micro-pay</div>
        </div>

        <div class="p-4 rounded-xl bg-slate-900/40 border border-slate-800/60 backdrop-blur-sm">
          <div class="text-2xl font-mono font-bold text-purple-400">100% Open</div>
          <div class="text-xs text-slate-400 mt-1">Contribute via Git PRs, no permission required</div>
        </div>
      </div>

    </div>
  </div>
</section>
