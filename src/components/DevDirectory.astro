---
import { developers } from '../data/devs';
---

<section id="devs" class="py-16 md:py-24 border-b border-slate-800/60 bg-[#080c14]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Title & Context -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6">
      <div>
        <div class="inline-flex items-center gap-2 text-xs font-mono font-semibold text-emerald-400 tracking-wider uppercase mb-2">
          <span>// Global Remittance & Talent Rails</span>
        </div>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
          Kisumu Bitcoin Dev Directory
        </h2>
        <p class="mt-2 text-base text-slate-400 max-w-2xl">
          Hire verified Western Kenyan engineers for remote contracts, open-source Bitcoin bounties, or send satoshis directly across borders over the Lightning Network.
        </p>
      </div>

      <!-- Add profile callout CTA -->
      <a 
        href="#join-guild" 
        class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-slate-700 bg-slate-900/60 hover:bg-slate-800 text-xs font-mono text-slate-300 hover:text-white transition-colors self-start md:self-auto"
      >
        <span>+ Add Yourself via GitHub PR</span>
        <span>↗</span>
      </a>
    </div>

    <!-- Developer Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {developers.map((dev) => (
        <div class="rounded-2xl border border-slate-800 bg-[#0c121e]/90 p-6 flex flex-col justify-between hover:border-slate-700 transition-all shadow-xl hover:shadow-[#F7931A]/5 relative group">
          
          <div>
            <!-- Header of card -->
            <div class="flex items-start justify-between gap-4 mb-4">
              <div>
                <div class="flex items-center gap-2">
                  <h3 class="font-bold text-lg text-white group-hover:text-[#F7931A] transition-colors">
                    {dev.name}
                  </h3>
                  {dev.availableForHire && (
                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-mono font-semibold bg-emerald-950 text-emerald-300 border border-emerald-800">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                      Open for Hire
                    </span>
                  )}
                </div>
                <p class="text-xs font-mono text-slate-400 mt-0.5">{dev.role}</p>
              </div>

              <!-- Location Tag -->
              <span class="text-[11px] font-mono text-slate-400 px-2 py-1 rounded bg-slate-800/80 border border-slate-700/60">
                📍 {dev.location}
              </span>
            </div>

            <!-- Bio -->
            <p class="text-xs sm:text-sm text-slate-300 leading-relaxed mb-4">
              {dev.bio}
            </p>

            <!-- Featured project if available -->
            {dev.featuredProject && (
              <div class="mb-4 p-3 rounded-xl bg-slate-950/60 border border-slate-800/80 text-xs">
                <div class="text-[10px] font-mono uppercase text-[#F7931A] mb-1">Featured Build</div>
                <div class="font-semibold text-slate-200">{dev.featuredProject.name}</div>
                <div class="text-slate-400 text-[11px] mt-0.5">{dev.featuredProject.description}</div>
              </div>
            )}

            <!-- Skills chips -->
            <div class="flex flex-wrap gap-1.5 mb-6">
              {dev.skills.map((skill) => (
                <span class="text-[11px] font-mono px-2 py-0.5 rounded-md bg-slate-800/60 text-slate-300 border border-slate-700/50">
                  {skill}
                </span>
              ))}
            </div>
          </div>

          <!-- Bottom Action Rails -->
          <div class="pt-4 border-t border-slate-800 flex items-center justify-between gap-3">
            
            <!-- External Links (GitHub, etc) -->
            <div class="flex items-center gap-2">
              <a 
                href={dev.github} 
                target="_blank" 
                rel="noopener noreferrer"
                class="p-2 rounded-lg bg-slate-800/60 hover:bg-slate-700 text-slate-300 hover:text-white transition-colors"
                title="View GitHub"
              >
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                  <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
                </svg>
              </a>

              <span class="text-xs font-mono text-slate-400 hidden sm:inline" title={dev.lightningAddress}>
                ⚡ {dev.lightningAddress.split('@')[0]}@...
              </span>
            </div>

            <!-- Tip / Pay Button -->
            <button 
              class="open-tip-modal-btn px-3.5 py-1.5 rounded-lg bg-[#F7931A]/10 hover:bg-[#F7931A]/20 border border-[#F7931A]/40 text-[#F7931A] text-xs font-mono font-bold flex items-center gap-1.5 transition-all active:scale-95 shadow-sm"
              data-dev-id={dev.id}
              data-dev-name={dev.name}
              data-lightning={dev.lightningAddress}
            >
              <span>⚡ Tip / Pay Sats</span>
            </button>
          </div>

        </div>
      ))}
    </div>

    <!-- How to join guild instructions box -->
    <div id="join-guild" class="mt-12 rounded-2xl border border-slate-800 bg-slate-900/40 p-6 sm:p-8">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div>
          <h3 class="text-lg font-bold text-white flex items-center gap-2">
            <span>Are you a developer in Kisumu building with Bitcoin?</span>
          </h3>
          <p class="mt-1 text-sm text-slate-400">
            Join the directory by submitting a pull request to <code class="px-1.5 py-0.5 rounded bg-slate-800 text-[#F7931A] font-mono text-xs">src/data/devs.ts</code> on our GitHub repository.
          </p>
        </div>

        <a 
          href="https://github.com" 
          target="_blank" 
          rel="noopener noreferrer"
          class="px-4 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-white font-mono text-xs font-bold transition-colors inline-flex items-center gap-2 self-start md:self-auto"
        >
          <span>Fork & Add Profile</span>
          <span>→</span>
        </a>
      </div>
    </div>

  </div>
</section>
