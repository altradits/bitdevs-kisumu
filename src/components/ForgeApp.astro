---
import { octoberSprintRoadmap } from '../data/octoberSprintRoadmap';
import { globalBountyPrograms } from '../data/openSourceBounties';
import { toolsToBuild } from '../data/toolsToBuild';

const totalDailyTasks = octoberSprintRoadmap.reduce((acc, w) => acc + w.dailyPlan.length, 0);
const totalTools = toolsToBuild.length;
const totalPrograms = globalBountyPrograms.length;

const prTemplateText = `## Summary
Fixes #[issue_number] or implements [feature_name] in pure Go.

## Motivation & Context
In emerging markets with limited bandwidth, memory optimization and offline reliability are paramount.

## Changes Made
- [x] Implemented module with zero heap allocations on hot path
- [x] Added comprehensive unit tests against standard Bitcoin test vectors
- [x] Tested with go test -race ./... and golangci-lint run

## Benchmark Results
BenchmarkExecution-8   1000000   1024 ns/op   0 B/op   0 allocs/op

Signed-off-by: Stanley Thuita <altradits@gmail.com>`;

const grantPitchText = `Subject: Developer Grant Application — Stanley Thuita (Kenya)

Hi Team,

I am Stanley Thuita (altradits), a Go engineer and Co-Founder of BitDevs Kisumu in Western Kenya.

My focus is building sovereign Bitcoin infrastructure adapted for African constraints:
1. altradits/challenges: 158-lesson Go engineering curriculum training local developers
2. altradits/bitkeys & rawtx: Pure Go Bitcoin cryptographic primitives and transaction signing
3. altradits/l402-proxy: Lightning micropayment proxies for local developers to attract global revenue
4. Blockstream Satellite node synchronization for the Lake Victoria basin

With this fellowship, I will commit full-time to contributing to Bitcoin Core / LDK / btcsuite, ensuring African developers have first-class open-source tooling and resilience.

GitHub: https://github.com/altradits
Community: https://bitdevs-kisumu.vercel.app`;

const bitcoinMagPitchText = `To: editor@bitcoinmagazine.com
Subject: CONTRIBUTOR SUBMISSION: How Western Kenya is Syncing Bitcoin from Space Without Telcos

Hi Editors,

I am Stanley Thuita, a software engineer and Co-Founder of BitDevs Kisumu on the shores of Lake Victoria in Kenya.

I would like to pitch a 1,500-word technical field report:
"Syncing the Blockchain from Space: Running Blockstream Satellite Nodes in Western Kenya"

In the Lake Victoria basin, recurring fiber cuts and expensive mobile data often isolate local nodes. In this piece, I share:
- How our developer guild set up standard secondhand DStv dishes with RTL-SDR v4 dongles tuned to 82.4°E Azimuth.
- Why zero-internet Bitcoin broadcasts are critical for African financial sovereignty.
- Real performance metrics, block arrival latencies, and how offline nodes keep the network resilient.

I have previously built a 158-lesson Go engineering curriculum (github.com/altradits) and lead our monthly Socratic Seminars.

Looking forward to your thoughts!

Best,
Stanley Thuita
GitHub: https://github.com/altradits`;

const stackerNewsPostText = `Title: [Tutorial] Building a Zero-Allocation Bitcoin Address Generator in Pure Go

Hey stackers! ⚡

As part of our BitDevs Kisumu guild in Western Kenya, we've been auditing how Bitcoin cryptographic primitives are constructed from scratch in Go without blackbox dependencies.

Here is a breakdown of how we derive SegWit Native (Bech32 bc1q) and Taproot (Bech32m bc1p) addresses in under 5 microseconds per address with zero heap allocations on the hot path.

### 1. The Hashing Pipeline: Hash160
[Insert code snippet of Hash160]

### 2. 8-to-5 Bit Conversion for Bech32
[Insert explanation of polymod checksum constant 0x2bc830a3 for BIP-350]

### 3. Why In-Place Memory Matters in Emerging Markets
[Explain memory constraints on low-end hardware]

Full open-source code and benchmarks: https://github.com/altradits/bitkeys

What edge cases have you encountered when handling Bech32m test vectors? Would love feedback!`;
---

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10" id="forge-root">
  
  <!-- Personal Command Center Header -->
  <div class="rounded-3xl border border-slate-800 bg-gradient-to-br from-[#0c121e] via-[#080d17] to-[#0c121e] p-6 sm:p-8 shadow-2xl relative overflow-hidden mb-10">
    <div class="absolute top-0 right-0 w-96 h-96 bg-[#F7931A]/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6 pb-6 border-b border-slate-800/80">
      <div>
        <div class="flex flex-wrap items-center gap-2 mb-3">
          <span class="px-3 py-1 rounded-full bg-[#F7931A]/15 border border-[#F7931A]/40 text-xs font-mono font-bold text-[#F7931A]">
            ⚡ Stanley Thuita (Altradits) Command Center
          </span>
          <span class="px-3 py-1 rounded-full bg-emerald-950/80 border border-emerald-800 text-xs font-mono font-bold text-emerald-300 flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            Sprint Starts Monday, October 5th, 2026
          </span>
        </div>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight leading-tight">
          Bitcoin Open Source Accelerator & Earning Radar
        </h1>
        <p class="mt-2 text-sm sm:text-base text-slate-300 max-w-2xl leading-relaxed">
          Your personal engineering roadmap to master Bitcoin protocol development in pure Go, build a portfolio of 5 production tools, and capture paying global open-source grants and sats bounties.
        </p>
      </div>

      <!-- Live Interactive Stats & Target Tracker -->
      <div class="flex flex-wrap sm:flex-nowrap items-center gap-3 bg-slate-950/90 p-4 rounded-2xl border border-slate-800">
        <div class="text-center px-3 border-r border-slate-800">
          <span class="text-[10px] font-mono uppercase text-slate-500 block">Daily Tasks Done</span>
          <span id="hud-tasks-done" class="text-lg font-mono font-extrabold text-[#F7931A]">0 / {totalDailyTasks}</span>
          <span class="text-[10px] text-slate-400 block font-mono">Oct 5 – Nov 1</span>
        </div>

        <div class="text-center px-3 border-r border-slate-800">
          <span class="text-[10px] font-mono uppercase text-slate-500 block">Tools Shipped</span>
          <span id="hud-tools-done" class="text-lg font-mono font-extrabold text-[#38BDF8]">0 / {totalTools}</span>
          <span class="text-[10px] text-slate-400 block font-mono">Proof-of-Work</span>
        </div>

        <div class="text-center px-3">
          <span class="text-[10px] font-mono uppercase text-slate-500 block">Paying Programs</span>
          <span class="text-lg font-mono font-extrabold text-emerald-400">{totalPrograms} Active</span>
          <span class="text-[10px] text-slate-400 block font-mono">$25k–$150k Grants</span>
        </div>
      </div>
    </div>

    <!-- Overall Sprint Progress Bar -->
    <div class="mt-6">
      <div class="flex items-center justify-between text-xs font-mono text-slate-400 mb-2">
        <span class="flex items-center gap-2">
          <span>🚀 October Sprint Mastery Progress:</span>
          <span id="hud-progress-percent" class="text-[#F7931A] font-bold">0% Completed</span>
        </span>
        <span class="text-slate-500">Destination: Funded Open-Source Fellow</span>
      </div>
      <div class="w-full h-3 bg-slate-900 rounded-full overflow-hidden border border-slate-800">
        <div id="hud-progress-bar" class="h-full bg-gradient-to-r from-[#F7931A] via-amber-400 to-emerald-400 w-0 transition-all duration-500 rounded-full"></div>
      </div>
    </div>

    <!-- Navigation Tabs -->
    <div class="mt-8 flex flex-wrap gap-2 pt-4 border-t border-slate-800/60" id="forge-tabs">
      <button 
        data-tab="roadmap" 
        class="tab-btn px-4 py-2.5 rounded-xl font-mono text-xs font-bold transition-all flex items-center gap-2 bg-[#F7931A] text-black shadow-md"
      >
        <span>📅 October 5th Sprint Roadmap</span>
        <span class="px-1.5 py-0.5 rounded bg-black/20 text-black text-[10px] font-mono">
          4 Weeks
        </span>
      </button>

      <button 
        data-tab="paying-radar" 
        class="tab-btn px-4 py-2.5 rounded-xl font-mono text-xs font-bold transition-all flex items-center gap-2 bg-slate-800/80 hover:bg-slate-700 text-slate-300 hover:text-white"
      >
        <span>💰 Global Paying Projects Radar</span>
        <span class="px-1.5 py-0.5 rounded bg-emerald-900/60 text-emerald-300 text-[10px] font-mono">
          {totalPrograms} Programs
        </span>
      </button>

      <button 
        data-tab="tools-pipeline" 
        class="tab-btn px-4 py-2.5 rounded-xl font-mono text-xs font-bold transition-all flex items-center gap-2 bg-slate-800/80 hover:bg-slate-700 text-slate-300 hover:text-white"
      >
        <span>🛠️ 5 Bitcoin Tools to Build</span>
        <span class="px-1.5 py-0.5 rounded bg-blue-900/60 text-blue-300 text-[10px] font-mono">
          {totalTools} Repos
        </span>
      </button>

      <button 
        data-tab="pr-playbook" 
        class="tab-btn px-4 py-2.5 rounded-xl font-mono text-xs font-bold transition-all flex items-center gap-2 bg-slate-800/80 hover:bg-slate-700 text-slate-300 hover:text-white"
      >
        <span>📝 PR & Grant Playbook</span>
      </button>
    </div>
  </div>

  <!-- TAB 1: OCTOBER 5TH SPRINT ROADMAP -->
  <div id="tab-roadmap" class="tab-pane block space-y-8">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-2">
      <div>
        <h2 class="text-2xl font-bold text-white flex items-center gap-2">
          <span>📅 October 5th – November 1st Daily Sprint</span>
        </h2>
        <p class="text-sm text-slate-400 mt-1">
          Every single day has a clear theoretical reading, a practice assignment, and a concrete codebase deliverable. Check off days as you complete them to track your progress.
        </p>
      </div>
      <div class="px-3.5 py-1.5 rounded-xl bg-slate-900 border border-slate-800 text-xs font-mono text-[#F7931A]">
        Total Est. Effort: ~110 Hours
      </div>
    </div>

    <div class="space-y-8">
      {octoberSprintRoadmap.map((week) => (
        <div class="rounded-2xl border border-slate-800 bg-[#0c121e]/90 p-6 sm:p-8 shadow-xl">
          
          <!-- Week Header -->
          <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 pb-5 border-b border-slate-800">
            <div>
              <div class="flex items-center gap-2">
                <span class="px-2.5 py-0.5 rounded text-xs font-mono font-bold bg-[#F7931A] text-black">
                  WEEK {week.week}
                </span>
                <span class="text-xs font-mono text-slate-400">
                  {week.dates}
                </span>
              </div>
              <h3 class="text-xl font-bold text-white mt-1.5">{week.title}</h3>
              <p class="text-xs text-slate-400 mt-0.5 font-mono">{week.coreGoal}</p>
            </div>

            <!-- Tool Target for this Week -->
            <div class="p-3.5 rounded-xl bg-slate-950 border border-slate-800 flex items-center gap-3">
              <span class="text-2xl">📦</span>
              <div>
                <span class="text-[10px] font-mono uppercase text-[#F7931A] font-bold block">Deliverable Tool</span>
                <span class="font-bold text-sm text-white font-mono">{week.toolToBuild.name}</span>
                <span class="text-[11px] text-slate-400 block max-w-xs truncate">{week.toolToBuild.description}</span>
              </div>
            </div>
          </div>

          <!-- Daily Plan Table / Cards -->
          <div class="mt-6 space-y-3">
            {week.dailyPlan.map((day) => (
              <div 
                class="daily-task-row p-4 rounded-xl bg-slate-950/70 border border-slate-800/80 hover:border-slate-700 transition-colors flex flex-col md:flex-row md:items-center justify-between gap-4"
                data-task-id={`task-${day.date.replace(/\s+/g, '-').toLowerCase()}`}
              >
                <div class="flex items-start gap-3">
                  <input 
                    type="checkbox" 
                    class="task-checkbox mt-1 w-4 h-4 rounded border-slate-700 text-[#F7931A] focus:ring-[#F7931A] focus:ring-offset-0 bg-slate-900 cursor-pointer"
                    data-task-id={`task-${day.date.replace(/\s+/g, '-').toLowerCase()}`}
                  />
                  <div>
                    <div class="flex items-center gap-2">
                      <span class="text-xs font-mono font-bold text-[#F7931A]">{day.date} ({day.day}):</span>
                      <h4 class="font-bold text-sm text-white">{day.topic}</h4>
                      <span class="text-[10px] font-mono text-slate-500">⏱ {day.estimatedHours}h</span>
                    </div>

                    <p class="text-xs text-slate-300 mt-1">
                      <strong class="text-slate-400">Reading:</strong> {day.reading}
                    </p>
                    <p class="text-xs text-slate-300 mt-0.5">
                      <strong class="text-slate-400">Assignment:</strong> {day.practiceAssignment}
                    </p>
                  </div>
                </div>

                <!-- Deliverable Badge -->
                <div class="md:text-right shrink-0">
                  <span class="text-[10px] font-mono text-slate-500 uppercase block">Code Deliverable</span>
                  <span class="text-xs font-mono font-semibold text-[#38BDF8]">{day.toolDeliverable}</span>
                </div>
              </div>
            ))}
          </div>

        </div>
      ))}
    </div>
  </div>

  <!-- TAB 2: GLOBAL PAYING PROJECTS RADAR -->
  <div id="tab-paying-radar" class="tab-pane hidden space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-2">
      <div>
        <h2 class="text-2xl font-bold text-white flex items-center gap-2">
          <span>💰 Available Paying Open Source Programs Online</span>
        </h2>
        <p class="text-sm text-slate-400 mt-1">
          Active international grants, fellowships, and per-issue Lightning bounties where you can apply or push PRs to get paid in Bitcoin / USD.
        </p>
      </div>

      <div class="flex items-center gap-2">
        <span class="text-xs font-mono text-slate-400">Total Opportunities:</span>
        <span class="px-2.5 py-1 rounded bg-[#F7931A]/10 border border-[#F7931A]/30 text-xs font-mono font-bold text-[#F7931A]">
          {globalBountyPrograms.length} Verified Sources
        </span>
      </div>
    </div>

    <!-- Category Filters -->
    <div class="flex flex-wrap gap-2 py-3 border-y border-slate-800/80" id="radar-filter-btns">
      <button data-filter="all" class="radar-filter-btn px-3.5 py-1.5 rounded-lg text-xs font-mono font-bold transition-all bg-[#F7931A] text-black">
        All Sources ({globalBountyPrograms.length})
      </button>
      <button data-filter="Writing for Sats" class="radar-filter-btn px-3.5 py-1.5 rounded-lg text-xs font-mono font-bold transition-all bg-slate-900 border border-slate-800 text-slate-300 hover:text-white">
        ✍️ Writing for Sats (4)
      </button>
      <button data-filter="Annual Fellowship,Milestone Grant" class="radar-filter-btn px-3.5 py-1.5 rounded-lg text-xs font-mono font-bold transition-all bg-slate-900 border border-slate-800 text-slate-300 hover:text-white">
        🏆 Fellowships & Grants (5)
      </button>
      <button data-filter="Per-Issue Bounty" class="radar-filter-btn px-3.5 py-1.5 rounded-lg text-xs font-mono font-bold transition-all bg-slate-900 border border-slate-800 text-slate-300 hover:text-white">
        💻 Code & PR Bounties (3)
      </button>
      <button data-filter="Micro-Tasks & Freelance" class="radar-filter-btn px-3.5 py-1.5 rounded-lg text-xs font-mono font-bold transition-all bg-slate-900 border border-slate-800 text-slate-300 hover:text-white">
        ⚡ Micro-Tasks & Gigs (2)
      </button>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6" id="radar-cards-grid">
      {globalBountyPrograms.map((prog) => (
        <div 
          class="bounty-card rounded-2xl border border-slate-800 bg-[#0c121e]/90 p-6 sm:p-7 flex flex-col justify-between hover:border-[#F7931A]/40 transition-all shadow-xl group"
          data-type={prog.payoutType}
          data-cat={prog.category}
        >
          <div>
            <!-- Header -->
            <div class="flex items-start justify-between gap-4 mb-3">
              <div>
                <span class="text-[10px] font-mono uppercase px-2 py-0.5 rounded bg-slate-800 text-[#F7931A] border border-slate-700 font-bold">
                  {prog.payoutType}
                </span>
                <span class="ml-2 text-[10px] font-mono text-slate-400">
                  {prog.sponsor}
                </span>
                <h3 class="font-bold text-xl text-white group-hover:text-[#F7931A] transition-colors mt-2">
                  {prog.name}
                </h3>
              </div>

              <!-- Payout Range -->
              <div class="text-right shrink-0">
                <div class="text-base sm:text-lg font-mono font-extrabold text-emerald-400">
                  {prog.payoutRange}
                </div>
                <div class="text-[10px] font-mono text-slate-400">
                  {prog.payoutCurrency}
                </div>
              </div>
            </div>

            <!-- Description -->
            <p class="text-xs sm:text-sm text-slate-300 leading-relaxed mb-4">
              {prog.description}
            </p>

            <!-- Tech stack chips -->
            <div class="flex flex-wrap gap-1.5 mb-4">
              {prog.techStack.map((tech) => (
                <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-slate-900 text-slate-300 border border-slate-800">
                  {tech}
                </span>
              ))}
            </div>

            <!-- Stanley's Winning Strategy Box -->
            <div class="p-3.5 rounded-xl bg-amber-950/20 border border-amber-900/40 text-xs mb-4">
              <div class="text-[10px] font-mono uppercase tracking-wider text-[#F7931A] font-bold mb-1 flex items-center gap-1.5">
                <span>🎯 Stanley's Winning Strategy</span>
              </div>
              <p class="text-amber-200/90 leading-relaxed">
                {prog.winningStrategy}
              </p>
            </div>

            <!-- Sample deliverables -->
            <div class="mb-2">
              <span class="text-[10px] font-mono uppercase text-slate-400 font-semibold block mb-1">
                Sample Target Deliverables / Issues
              </span>
              <ul class="space-y-1 text-xs text-slate-300">
                {prog.sampleIssuesOrDeliverables.map((item) => (
                  <li class="flex items-start gap-2">
                    <span class="text-[#38BDF8] font-bold">›</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <!-- Bottom Action Buttons -->
          <div class="mt-6 pt-4 border-t border-slate-800 flex items-center justify-between gap-3">
            <span class="text-[11px] font-mono text-slate-400">
              Status: <strong class="text-emerald-400">{prog.applicationStatus}</strong>
            </span>

            <div class="flex items-center gap-2">
              {prog.issuesUrl && (
                <a 
                  href={prog.issuesUrl} 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-xs font-mono text-slate-300 hover:text-white transition-colors"
                >
                  Live Issues ↗
                </a>
              )}
              <a 
                href={prog.url} 
                target="_blank" 
                rel="noopener noreferrer"
                class="px-4 py-1.5 rounded-lg bg-[#F7931A] hover:bg-[#E27909] text-black font-mono font-bold text-xs transition-all shadow-md flex items-center gap-1"
              >
                <span>Apply / Submit</span>
                <span>↗</span>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- TAB 3: 5 BITCOIN TOOLS TO BUILD -->
  <div id="tab-tools-pipeline" class="tab-pane hidden space-y-8">
    <div class="mb-4">
      <h2 class="text-2xl font-bold text-white flex items-center gap-2">
        <span>🛠️ The 5 Bitcoin Practice Tools to Build in Go</span>
      </h2>
      <p class="text-sm text-slate-400 mt-1">
        Instead of just solving throwaway exercises, every week you will package what you learn into a standalone, production-ready Go repository. These repos serve as your undeniable Proof-of-Work to win grants from Brink, Spiral, and HRF.
      </p>
    </div>

    <div class="space-y-6">
      {toolsToBuild.map((tool) => (
        <div class="rounded-2xl border border-slate-800 bg-[#0c121e]/90 p-6 sm:p-8 shadow-xl">
          <div class="flex flex-col lg:flex-row lg:items-start justify-between gap-6 pb-4 border-b border-slate-800">
            <div>
              <div class="flex items-center gap-2">
                <span class="px-2.5 py-0.5 rounded text-xs font-mono font-bold bg-[#38BDF8] text-black">
                  Week {tool.weekAssigned}
                </span>
                <span class="text-xs font-mono text-slate-400">{tool.dates}</span>
              </div>
              <h3 class="text-2xl font-mono font-extrabold text-white mt-2 flex items-center gap-2">
                <span>{tool.name}</span>
                <span class="text-xs font-mono font-normal text-slate-400">({tool.repo})</span>
              </h3>
              <p class="text-sm text-[#F7931A] font-mono mt-0.5">{tool.tagline}</p>
            </div>

            <!-- How it earns sats pill -->
            <div class="p-3 rounded-xl bg-emerald-950/40 border border-emerald-800/80 text-xs font-mono text-emerald-300 max-w-sm">
              <strong class="text-emerald-400 uppercase text-[10px] block mb-0.5">💰 How It Earns Sats:</strong>
              {tool.howItEarnsSats}
            </div>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mt-6">
            
            <!-- Details & Learning outcome -->
            <div>
              <div class="mb-4">
                <span class="text-[10px] font-mono uppercase text-slate-400 font-bold block mb-1">
                  Learning Outcome
                </span>
                <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
                  {tool.learningOutcome}
                </p>
              </div>

              <div>
                <span class="text-[10px] font-mono uppercase text-slate-400 font-bold block mb-2">
                  Key Specifications
                </span>
                <ul class="space-y-1.5 text-xs text-slate-300">
                  {tool.keyFeatures.map((feat) => (
                    <li class="flex items-start gap-2">
                      <span class="text-[#F7931A]">✓</span>
                      <span>{feat}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <div class="mt-4 flex flex-wrap gap-1.5">
                {tool.techStack.map((tech) => (
                  <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-slate-900 text-slate-400 border border-slate-800">
                    {tech}
                  </span>
                ))}
              </div>
            </div>

            <!-- Interactive CLI Terminal Output Preview -->
            <div class="flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between text-[11px] font-mono text-slate-500 mb-1 pb-1">
                  <span>Terminal Execution Preview</span>
                  <span>CLI Output</span>
                </div>
                <pre class="p-4 rounded-xl bg-slate-950 border border-slate-800 font-mono text-xs text-slate-200 overflow-x-auto whitespace-pre leading-relaxed">{tool.cliPreview}</pre>
              </div>

              <div class="mt-4 pt-3 flex items-center justify-between">
                <a 
                  href={`https://github.com/${tool.repo}`} 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-xs font-mono text-white transition-colors flex items-center gap-1.5"
                >
                  <span>Create / View {tool.repo} on GitHub</span>
                  <span>↗</span>
                </a>

                <button 
                  class="tool-shipped-btn px-4 py-2 rounded-xl bg-emerald-950/80 hover:bg-emerald-900 border border-emerald-800 text-emerald-300 font-mono text-xs font-semibold transition-all"
                  data-tool-id={tool.id}
                >
                  Mark Tool Shipped ✓
                </button>
              </div>
            </div>

          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- TAB 4: PR & GRANT PLAYBOOK -->
  <div id="tab-pr-playbook" class="tab-pane hidden space-y-6">
    <div class="rounded-2xl border border-slate-800 bg-[#0c121e]/90 p-6 sm:p-8 shadow-xl">
      <div class="mb-6 pb-4 border-b border-slate-800">
        <h2 class="text-2xl font-bold text-white flex items-center gap-2">
          <span>📝 Open Source PR & Grant Application Playbook</span>
        </h2>
        <p class="text-sm text-slate-400 mt-1">
          Exact templates and guidelines to submit clean, review-ready pull requests to external Bitcoin projects and draft compelling grant applications to Brink and Spiral.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        
        <!-- Pull Request Template -->
        <div class="space-y-4">
          <div class="flex items-center justify-between text-xs font-mono text-slate-400">
            <span class="uppercase font-bold text-white">1. External GitHub PR Template</span>
            <button id="copy-pr-template-btn" class="text-[#F7931A] hover:underline">Copy Markdown</button>
          </div>
          <textarea 
            id="pr-template-text"
            rows="14" 
            class="w-full p-4 rounded-xl bg-slate-950 border border-slate-800 font-mono text-xs text-slate-300 focus:outline-none focus:border-[#F7931A]"
            readonly
          >{prTemplateText}</textarea>
        </div>

        <!-- Grant Proposal Template -->
        <div class="space-y-4">
          <div class="flex items-center justify-between text-xs font-mono text-slate-400">
            <span class="uppercase font-bold text-white">2. Brink / Spiral Fellowship Pitch Template</span>
            <button id="copy-grant-pitch-btn" class="text-[#38BDF8] hover:underline">Copy Pitch</button>
          </div>
          <textarea 
            id="grant-pitch-text"
            rows="14" 
            class="w-full p-4 rounded-xl bg-slate-950 border border-slate-800 font-mono text-xs text-slate-300 focus:outline-none focus:border-[#38BDF8]"
            readonly
          >{grantPitchText}</textarea>
        </div>

        <!-- Bitcoin Magazine Pitch Template -->
        <div class="space-y-4">
          <div class="flex items-center justify-between text-xs font-mono text-slate-400">
            <span class="uppercase font-bold text-white">3. Bitcoin Magazine Pitch ($150–$350 in BTC)</span>
            <button id="copy-mag-pitch-btn" class="text-emerald-400 hover:underline">Copy Pitch</button>
          </div>
          <textarea 
            id="mag-pitch-text"
            rows="14" 
            class="w-full p-4 rounded-xl bg-slate-950 border border-slate-800 font-mono text-xs text-slate-300 focus:outline-none focus:border-emerald-400"
            readonly
          >{bitcoinMagPitchText}</textarea>
        </div>

        <!-- Stacker News Post Template -->
        <div class="space-y-4">
          <div class="flex items-center justify-between text-xs font-mono text-slate-400">
            <span class="uppercase font-bold text-white">4. Stacker News Post (Earn Instant Sats/Zaps)</span>
            <button id="copy-stacker-post-btn" class="text-[#F7931A] hover:underline">Copy Post</button>
          </div>
          <textarea 
            id="stacker-post-text"
            rows="14" 
            class="w-full p-4 rounded-xl bg-slate-950 border border-slate-800 font-mono text-xs text-slate-300 focus:outline-none focus:border-[#F7931A]"
            readonly
          >{stackerNewsPostText}</textarea>
        </div>

      </div>
    </div>
  </div>

</div>

<script>
  // HUD State in localStorage
  const ROADMAP_STORAGE_KEY = 'stanley_october_sprint_state';

  interface SprintState {
    checkedTasks: string[];
    shippedTools: string[];
  }

  const defaultState: SprintState = {
    checkedTasks: [],
    shippedTools: []
  };

  function loadState(): SprintState {
    try {
      const data = localStorage.getItem(ROADMAP_STORAGE_KEY);
      return data ? JSON.parse(data) : defaultState;
    } catch {
      return defaultState;
    }
  }

  function saveState(state: SprintState) {
    try {
      localStorage.setItem(ROADMAP_STORAGE_KEY, JSON.stringify(state));
    } catch {}
  }

  function updateSprintHUD() {
    const state = loadState();
    const tasksDoneEl = document.getElementById('hud-tasks-done');
    const toolsDoneEl = document.getElementById('hud-tools-done');
    const progressBar = document.getElementById('hud-progress-bar');
    const progressPercent = document.getElementById('hud-progress-percent');

    const totalTasks = 28; // 4 weeks * 7 days
    const totalTools = 5;
    const tasksDone = state.checkedTasks.length;
    const toolsDone = state.shippedTools.length;

    if (tasksDoneEl) tasksDoneEl.textContent = `${tasksDone} / ${totalTasks}`;
    if (toolsDoneEl) toolsDoneEl.textContent = `${toolsDone} / ${totalTools}`;

    const totalWeight = totalTasks + (totalTools * 4); // each tool counts for 4 tasks
    const currentWeight = tasksDone + (toolsDone * 4);
    const pct = Math.min(100, Math.round((currentWeight / totalWeight) * 100));

    if (progressBar) progressBar.style.width = `${pct}%`;
    if (progressPercent) progressPercent.textContent = `${pct}% Completed`;

    // Sync checkboxes
    document.querySelectorAll('.task-checkbox').forEach(cb => {
      const input = cb as HTMLInputElement;
      const taskId = input.getAttribute('data-task-id');
      if (taskId) {
        input.checked = state.checkedTasks.includes(taskId);
        const row = document.querySelector(`.daily-task-row[data-task-id="${taskId}"]`);
        if (row) {
          if (input.checked) {
            row.classList.add('bg-emerald-950/20', 'border-emerald-800/60');
          } else {
            row.classList.remove('bg-emerald-950/20', 'border-emerald-800/60');
          }
        }
      }
    });

    // Sync tools buttons
    document.querySelectorAll('.tool-shipped-btn').forEach(btn => {
      const toolId = btn.getAttribute('data-tool-id');
      if (toolId && state.shippedTools.includes(toolId)) {
        btn.textContent = 'Shipped ✓';
        btn.classList.add('bg-emerald-600', 'text-black');
      }
    });
  }

  // Handle task checkboxes
  document.querySelectorAll('.task-checkbox').forEach(cb => {
    cb.addEventListener('change', (e) => {
      const input = e.target as HTMLInputElement;
      const taskId = input.getAttribute('data-task-id');
      if (!taskId) return;

      const state = loadState();
      if (input.checked) {
        if (!state.checkedTasks.includes(taskId)) state.checkedTasks.push(taskId);
      } else {
        state.checkedTasks = state.checkedTasks.filter(id => id !== taskId);
      }
      saveState(state);
      updateSprintHUD();
    });
  });

  // Handle tool shipped button
  document.querySelectorAll('.tool-shipped-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const toolId = btn.getAttribute('data-tool-id');
      if (!toolId) return;

      const state = loadState();
      if (!state.shippedTools.includes(toolId)) {
        state.shippedTools.push(toolId);
      } else {
        state.shippedTools = state.shippedTools.filter(id => id !== toolId);
        btn.textContent = 'Mark Tool Shipped ✓';
        btn.classList.remove('bg-emerald-600', 'text-black');
      }
      saveState(state);
      updateSprintHUD();
    });
  });

  // Tabs logic
  const tabButtons = document.querySelectorAll('#forge-tabs .tab-btn');
  const tabPanes = document.querySelectorAll('.tab-pane');

  tabButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const targetId = btn.getAttribute('data-tab');
      
      tabButtons.forEach(b => {
        b.classList.remove('bg-[#F7931A]', 'text-black');
        b.classList.add('bg-slate-800/80', 'text-slate-300');
      });
      btn.classList.add('bg-[#F7931A]', 'text-black');
      btn.classList.remove('bg-slate-800/80', 'text-slate-300');

      tabPanes.forEach(pane => {
        if (pane.id === `tab-${targetId}`) {
          pane.classList.remove('hidden');
          pane.classList.add('block');
        } else {
          pane.classList.add('hidden');
          pane.classList.remove('block');
        }
      });
    });
  });

  // Radar category filters
  const radarFilterBtns = document.querySelectorAll('.radar-filter-btn');
  const bountyCards = document.querySelectorAll('.bounty-card');

  radarFilterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      radarFilterBtns.forEach(b => {
        b.classList.remove('bg-[#F7931A]', 'text-black');
        b.classList.add('bg-slate-900', 'border', 'border-slate-800', 'text-slate-300');
      });
      btn.classList.add('bg-[#F7931A]', 'text-black');
      btn.classList.remove('bg-slate-900', 'border', 'border-slate-800', 'text-slate-300');

      const filterVal = btn.getAttribute('data-filter') || 'all';
      const allowedTypes = filterVal.split(',');

      bountyCards.forEach(card => {
        const cardType = card.getAttribute('data-type') || '';
        if (filterVal === 'all' || allowedTypes.includes(cardType)) {
          (card as HTMLElement).style.display = 'flex';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    });
  });

  // Copy template buttons
  const copyPrBtn = document.getElementById('copy-pr-template-btn');
  const prText = document.getElementById('pr-template-text') as HTMLTextAreaElement;
  if (copyPrBtn && prText) {
    copyPrBtn.addEventListener('click', async () => {
      await navigator.clipboard.writeText(prText.value);
      copyPrBtn.textContent = 'Copied! ✓';
      setTimeout(() => copyPrBtn.textContent = 'Copy Markdown', 2000);
    });
  }

  const copyGrantBtn = document.getElementById('copy-grant-pitch-btn');
  const grantText = document.getElementById('grant-pitch-text') as HTMLTextAreaElement;
  if (copyGrantBtn && grantText) {
    copyGrantBtn.addEventListener('click', async () => {
      await navigator.clipboard.writeText(grantText.value);
      copyGrantBtn.textContent = 'Copied! ✓';
      setTimeout(() => copyGrantBtn.textContent = 'Copy Pitch', 2000);
    });
  }

  const copyMagBtn = document.getElementById('copy-mag-pitch-btn');
  const magText = document.getElementById('mag-pitch-text') as HTMLTextAreaElement;
  if (copyMagBtn && magText) {
    copyMagBtn.addEventListener('click', async () => {
      await navigator.clipboard.writeText(magText.value);
      copyMagBtn.textContent = 'Copied! ✓';
      setTimeout(() => copyMagBtn.textContent = 'Copy Pitch', 2000);
    });
  }

  const copyStackerBtn = document.getElementById('copy-stacker-post-btn');
  const stackerText = document.getElementById('stacker-post-text') as HTMLTextAreaElement;
  if (copyStackerBtn && stackerText) {
    copyStackerBtn.addEventListener('click', async () => {
      await navigator.clipboard.writeText(stackerText.value);
      copyStackerBtn.textContent = 'Copied! ✓';
      setTimeout(() => copyStackerBtn.textContent = 'Copy Post', 2000);
    });
  }

  // Initialize
  updateSprintHUD();
</script>
