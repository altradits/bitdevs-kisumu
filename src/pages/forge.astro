---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import ForgeApp from '../components/ForgeApp.astro';
import LightningTipModal from '../components/LightningTipModal.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="Altradits Bitcoin Dev Forge | Train in Go & Earn Sats on Lake Victoria"
  description="Accelerated Bitcoin protocol and Go engineering academy for Stanley Thuita (Altradits) and Kisumu developers. Complete structured challenges, solve paying bounties, and submit verified PRs."
>
  <Navbar />
  <main class="flex-grow">
    <ForgeApp />
  </main>
  <Footer />
  <LightningTipModal />
</Layout>
